		"@scalar/api-reference": "^1.73.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"elysia": "latest",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"pino-roll": "^4.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
