{
	"name": "cms",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"scalar": "bun scripts/copy-scalar.ts",
		"prestart:dev": "bun scalar",
		"prestart:app": "bun scalar",
		"prestart:build": "bun scalar",
		"start:dev": "bun --watch src/index.ts",
		"start:app": "bun src/index.ts --cluster",
